# Telegram CLI credentials — https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generate with: pnpm login:telegram (or pnpm login:telegram:qr)
TELEGRAM_SESSION=

# Full CLI denies guarded writes by default. This is not an OS sandbox.
TELLATIO_WRITE_GUARD=enforce
# Grant only for a specific approved invocation, never globally:
# TELLATIO_ALLOW_WRITES=1

# Telegram folder used as the no-read ban list.
TELLATIO_BAN_FOLDER_NAME=Banned

# Local media: single filenames inside uploads/ or downloads/ (25 MiB maximum).
# Defaults to the repository's data/ directory when omitted.
# DATA_DIR=./data

# File-backed secrets take precedence over plain environment variables:
# TELEGRAM_SESSION_FILE=/secure/telegram-session
# TELEGRAM_API_HASH_FILE=/secure/telegram-api-hash
# TELEGRAM_API_ID_FILE=/secure/telegram-api-id

# Optional Attio/worker configuration lives in docs/sync/.env.example.
