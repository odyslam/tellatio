# Add needed settings to the root .env; do not replace existing credentials.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
ATTIO_API_KEY=

# Approved mappings (default); "folder" enables legacy folder-based sync.
TELLATIO_SYNC_SOURCE=associations
TELLATIO_ASSOCIATION_OBJECT=telegram_associations
TELLATIO_IDENTITY_OBJECT=telegram_identities

# Opt-in legacy behavior; keep disabled unless intended.
TELLATIO_AUTO_CREATE_PEOPLE=false
TELLATIO_AUTO_CREATE_GROUP_PEOPLE=false
TELLATIO_FOLDER_FALLBACK_ENABLED=false
TELEGRAM_FOLDER_NAME=Attio

# Banned chats are excluded from discovery, reads, and sync.
TELLATIO_BAN_FOLDER_NAME=Banned
TELLATIO_CHAT_FETCH_TIMEOUT_SECONDS=30
TELLATIO_DISCOVERY_DIALOG_LIMIT=1000

# Seconds, when set, override minutes.
SYNC_INTERVAL_MINUTES=15
# SYNC_INTERVAL_SECONDS=900

# Matching hints: own-company names (comma-separated) and aliases (JSON).
TELLATIO_OWN_COMPANY_NAMES=
TELLATIO_COMPANY_ALIASES={}

# Persistent worker state; use ./data locally.
DATA_DIR=/data

# Interactive CLI only; does not gate the worker.
TELLATIO_WRITE_GUARD=enforce
