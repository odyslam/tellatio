{
  "name": "tellatio",
  "description": "Telegram CLI for terminal workflows and AI agents",
  "private": true,
  "version": "0.1.0",
  "bin": {
    "tellatio": "./bin/tellatio",
    "tellatio-readonly": "./bin/tellatio-readonly"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck",
    "test": "pnpm test:cli && pnpm test:sync",
    "dev": "bun src/cli.ts",
    "start": "node dist/cli.js",
    "login:telegram": "node scripts/telegram-login.js",
    "login:telegram:qr": "node scripts/telegram-login.js --qr",
    "tellatio": "bin/tellatio",
    "test:readonly": "node tests/cli/readonly-mcp-smoke.js",
    "test:cli": "ts-node tests/shared/guard-smoke.ts && ts-node tests/shared/secret-smoke.ts && ts-node tests/cli/folders-smoke.ts && ts-node tests/cli/cli-security-smoke.ts",
    "test:sync": "ts-node tests/attio/cli-logic-smoke.ts && ts-node tests/sync/state-smoke.ts && ts-node tests/sync/sync-security-smoke.ts && ts-node tests/attio/identity-security-smoke.ts && ts-node tests/attio/association-security-smoke.ts && ts-node tests/integration/security-smoke.ts && ts-node tests/integration/transport-security-smoke.ts",
    "sync:dev": "ts-node src/sync/main.ts",
    "sync:start": "node dist/sync/main.js",
    "sync:once": "ts-node scripts/sync/sync-once.ts",
    "attio:setup": "ts-node scripts/sync/setup-attio.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.15",
    "node-gyp": "12.3.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "incur": "0.5.1",
    "qrcode-terminal": "0.12.0",
    "telegram": "2.26.22",
    "undici": "8.12.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "@toon-format/toon": "2.3.1",
      "ip-address": "10.7.4",
      "node-gyp>undici": "6.29.1",
      "tar": "7.5.22",
      "diff@4": "4.0.4"
    }
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.19.0"
  }
}
